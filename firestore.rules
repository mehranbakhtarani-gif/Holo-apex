          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().lastVoucherNumber >= existing().lastVoucherNumber
          && incoming().diff(existing()).affectedKeys().hasOnly(['lastVoucherNumber', 'lastInvoiceSeq', 'updatedByDevice', 'updatedAt'])
        )
      );
      allow delete: if false;
    }

