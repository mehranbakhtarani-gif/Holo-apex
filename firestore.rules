        && isValidWorkspaceExtensions(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidWorkspaceExtensions(incoming()) && (
        isAdmin() || (
          isOwner(userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'reservedInvoices',
            'productMetaMap',
            'favoriteMenus',
            'pettyCashCeilingIrr',
            'pettyCashItems',
            'recurringTemplates',
            'bankLoans',
            'dyeLots',
            'warehouseSlips',
            'bomFormulas',
            'installmentPlans',
            'volumeDiscountRules',
            'moadianLinks',
            'fiscalArchives',
            '_version',
            'updatedByDevice',
            'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    match /devicePresence/{presenceId} {
      allow get: if isValidId(presenceId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(presenceId) && isVerified()
        && isValidDevicePresence(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(presenceId) && isVerified() && isValidDevicePresence(incoming()) && (
        isAdmin() || (
          existing().ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
          && incoming().deviceId == existing().deviceId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'deviceLabel',
            'operatorName',
            'activeModule',
            'editingRecordKey',
            'editingRecordLabel',
            'lastSeenMs',
            'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(presenceId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /cloudBackups/{backupId} {
      allow get: if isValidId(backupId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(backupId) && isVerified()
        && isValidCloudBackup(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(backupId) && isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
