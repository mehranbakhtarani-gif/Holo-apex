        "active": { "type": "boolean" },
        "permissions": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "fullName", "role", "active", "permissions", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable chronological audit trail of accounting, inventory, and multi-device actions",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
        "operatorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "operatorRole": { "type": "string", "enum": ["finance_manager", "accountant", "warehouse_keeper", "sales_officer", "auditor"] },
        "module": { "type": "string", "minLength": 1, "maxLength": 80 },
        "action": { "type": "string", "minLength": 1, "maxLength": 160 },
        "details": { "type": "string", "minLength": 1, "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "timestamp", "operatorName", "operatorRole", "module", "action", "details", "createdAt", "updatedAt"]
    },
    "WorkspaceExtensions": {
      "title": "WorkspaceExtensions",
      "description": "Cloud-synced Holoo Apex 9.6 workspace state across 3 devices (reserved invoices, barcodes, 4-tier pricing, favorites, petty cash, recurring vouchers, bank loans, dye-lots, warehouse slips, BOM formulas, installments, volume discounts, Moadian tax links, fiscal archives)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reservedInvoices": { "type": "array" },
        "productMetaMap": { "type": "object" },
        "favoriteMenus": { "type": "array" },
        "pettyCashCeilingIrr": { "type": "number" },
        "pettyCashItems": { "type": "array" },
        "recurringTemplates": { "type": "array" },
        "bankLoans": { "type": "array" },
        "dyeLots": { "type": "array" },
        "warehouseSlips": { "type": "array" },
        "bomFormulas": { "type": "array" },
        "installmentPlans": { "type": "array" },
        "volumeDiscountRules": { "type": "array" },
        "moadianLinks": { "type": "object" },
        "fiscalArchives": { "type": "array" },
        "_version": { "type": "number" },
        "updatedByDevice": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "createdAt", "updatedAt"]
    },
    "DevicePresence": {
      "title": "DevicePresence",
      "description": "Real-time online device heartbeat and concurrent record editing lock for multi-device collaboration",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "deviceLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "operatorName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "activeModule": { "type": "string", "minLength": 1, "maxLength": 48 },
        "editingRecordKey": { "type": "string", "maxLength": 128 },
        "editingRecordLabel": { "type": "string", "maxLength": 180 },
        "lastSeenMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "deviceId", "deviceLabel", "operatorName", "activeModule", "lastSeenMs", "createdAt", "updatedAt"]
    },
    "CloudBackup": {
      "title": "CloudBackup",
      "description": "Rolling cloud backup snapshot in Firestore (automatically pruned to retain only the latest 3 versions per user)",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "revision": { "type": "number" },
        "reason": { "type": "string", "enum": ["auto_sync", "manual_push"] },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deviceLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "companyName": { "type": "string", "maxLength": 160 },
        "fiscalYear": { "type": "string", "minLength": 4, "maxLength": 16 },
        "savedAtMs": { "type": "number" },
        "savedAtShamsi": { "type": "string", "minLength": 1, "maxLength": 48 },
        "voucherCount": { "type": "number" },
        "invoiceCount": { "type": "number" },
        "productCount": { "type": "number" },
        "sizeKb": { "type": "number" },
        "snapshot": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "revision", "reason", "deviceId", "deviceLabel", "fiscalYear", "savedAtMs", "savedAtShamsi", "voucherCount", "invoiceCount", "productCount", "sizeKb", "snapshot", "createdAt", "updatedAt"]
    }
  },
